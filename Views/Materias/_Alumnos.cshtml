@using Rol = ControlActividades.Roles;
@{
    ControlActividades.Recursos.FuncionalidadesGenerales fg = new ControlActividades.Recursos.FuncionalidadesGenerales();
}

<script>
    window.esDocente = @User.IsInRole(Rol.DOCENTE).ToString().ToLower();
    // Expose current MateriaId for client scripts
    window.materiaIdGlobal = @(ViewBag.MateriaId ??0);
</script>

@if (User != null && User.IsInRole("Docente"))
{
    <div id="docente-datos" style="display:none" data-docenteid="@(ViewBag.DocenteId ??0)"></div>

    <!-- Hidden field to help client scripts determine current MateriaId when the partial is rendered standalone -->
    <input type="hidden" id="materiaIdHidden" value="@(ViewBag.MateriaId ??0)" /><div class="container mt-3">
        <div class="row" style="align-items:center;">
            <div class="col-md-6">
                <label for="buscarAlumno" class="form-label">Buscar alumno por correo:</label>
                <div class="input-group" style="position:relative;">
                    <input type="text" id="buscarAlumno" class="form-control" placeholder="Escribe correo o nombre..." autocomplete="off" aria-autocomplete="list" aria-controls="sugerenciasAlumnos" />
                    @if (fg.ObtenerFuenteDeDatos() == FuenteDatos.DB)
                    {
                        <button id="btnAsignarAlumno" class="btn btn-primary" type="button">Asignar Alumno</button>
                    }

                    <ul id="sugerenciasAlumnos" class="list-group" style="position:absolute; top:100%; left:0; right:0; width:100%; z-index:2000; display:none; max-height:220px; overflow:auto; margin-top:4px;"></ul>
                </div>
            </div>
            <div class="col-md-6 d-flex justify-content-end">

                @if (fg.ObtenerFuenteDeDatos() == FuenteDatos.DB)
                {
                <!-- Template download button placed between assign and import -->
                <button type="button" id="btnDescargarPlantillaAlumnos" class="btn btn-outline-secondary me-2" title="Descargar plantilla de Excel (.xlsx)">
                    <i class="fas fa-file-excel" style="margin-right:8px"></i>Plantilla
                </button>
                    <button type="button" id="btnImportarAlumnos" class="btn btn-success" title="Importar desde Excel"><i class="fas fa-file-import" style="margin-right:8px"></i>Importar Alumnos</button>
                    <input type="file" id="fileImportarAlumnos" accept=".xlsx,.xls" style="display:none" />
                }

            </div>
        </div>
    </div>
    <div id="listaAlumnosAsignados" class="mt-3"></div>

    <script>
        (function() {
            var tplBtn = document.getElementById('btnDescargarPlantillaAlumnos');
            if (!tplBtn) return;
            tplBtn.addEventListener('click', function () {
                // Request the XLSX template from server endpoint
                var url = '@Url.Action("DescargarPlantillaAlumnos", "Materias")';
                // create anchor and click
                var a = document.createElement('a');
                a.href = url;
                a.download = 'plantilla_alumnos.xlsx';
                document.body.appendChild(a);
                a.click();
                setTimeout(function(){ try { a.remove(); } catch(e){} },500);

                if (window.Swal && typeof Swal.fire === 'function') {
                    Swal.fire({
                        icon: 'info',
                        title: 'Formato de importación',
                        html: 'La plantilla se descarga como archivo Excel (.xlsx). Columnas: <b>Email, Nombre, ApellidoPaterno, ApellidoMaterno</b>. Compatible con Excel2007-2022 (.xlsx/.xls).',
                        confirmButtonText: 'Entendido'
                    });
                }
            });
        })();
    </script>

    <!-- DataTables CSS/JS (loaded locally in this partial to avoid bundle config changes) -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <!-- Ensure docentes/alumnos script is loaded for search, assign and import behaviors -->
    <script src="~/Scripts/Docente/Grupos/scriptsAlumnos.js"></script>
}
