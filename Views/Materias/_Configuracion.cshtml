@{
    ViewBag.Title = "_Configuracion";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <h3 class="text-center mb-4">Configuración de la materia</h3>

            <div class="mb-3">
                <label class="form-label">Editar Nombre</label>
                <input id="configNombre" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Editar Descripción</label>
                <textarea id="configDescripcion" class="form-control" style="min-height:120px;"></textarea>
            </div>

            <div class="text-center mb-3">
                <button id="btnGuardarMateriaEditada" class="btn btn-primary btn-lg" type="button">Guardar</button>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <button id="btnCopiarMateria" class="btn btn-secondary">Copiar Materia</button>
                <button id="btnCambiarCodigo" class="btn btn-warning">Cambiar código de clase</button>
                <button id="btnEliminarMateria" class="btn btn-danger">Eliminar Materia</button>
            </div>
        </div>
    </div>
</div>
