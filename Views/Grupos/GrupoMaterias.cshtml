@*@model List<ControlActividades.Models.MateriaViewModel>*@
@model List<ControlActividades.Models.MateriaCARes>
@{
    Layout = "~/Views/Shared/_LayoutGeneral.cshtml";
    ViewBag.Title = "Materias del grupo";
    ViewBag.PageHeader = "Materias del grupo";
    int grupoId = Request.QueryString["grupoId"] != null ? int.Parse(Request.QueryString["grupoId"]) : 0;
}

<div class="container mt-4">
    <div id="listaMateriasGrupo" class="content">
        @foreach (var materia in Model)
        {
            <div class="card mb-3 min-vh-50 position-relative custom-card"
                 style="max-width: 540px">
                <button class="btn btn-light btn-sm position-absolute top-0 end-0 m-2 custom-button-settings">
                    <svg fill="#000000"
                         width="25px"
                         height="25px"
                         viewBox="0 0 24 24"
                         xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="17.5" r="1.5" />
                        <circle cx="12" cy="12" r="1.5" />
                        <circle cx="12" cy="6.5" r="1.5" />
                    </svg>
                </button>
                <a href="@Url.Action("MateriaDetalles", "Materias", new { materiaId = materia.MateriaId})" class="text-decoration-none text-reset">
                    <div class="row g-0 h-100">
                        <div class="col-md-4 d-flex align-items-center justify-content-center p-3" style="min-height:180px; background-color: @(""+(materia.CodigoColor ?? "#1db7f7"))">
                            <img src="~/Content/Iconos/materia_2.svg"
                                 class="img-fluid rounded-start"
                                 style="object-fit: cover"
                                 alt="..." />
                        </div>
                        <div class="col-md-8 d-flex flex-column">
                            <div class="card-body d-flex flex-column h-100">
                                <div class="flex-grow-1">
                                    <h5 class="card-title">@materia.NombreMateria</h5>
                                    <p class="card-text">
                                        <small class="text-body-secondary">@materia.ApellidoPaternoDocente @materia.ApellidoMaternoDocente @materia.NombresDocente</small>
                                    </p>
                                    <p class="card-text limit-lines">
                                        @materia.Descripcion
                                    </p>
                                </div>
                            </div>

                            <div class="card-bottom ">
                                <p class="card-text">
                                    <small class="text-body-secondary">Sin actividades</small>
                                </p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

@section styles{
    <link href="~/Content/Dashboard/cards-grupos-materias.css" rel="stylesheet" />
}

@section Scripts{
    @*<script src="~/Scripts/Docente/Grupos/mostrarMateriasGrupo.js"></script>*@
    @*<script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof cargarMateriasDeGrupo === 'function') cargarMateriasDeGrupo();
            });
        </script>
        <script src="~/Scripts/Materias/materias-grupo.js"></script>*@
}
