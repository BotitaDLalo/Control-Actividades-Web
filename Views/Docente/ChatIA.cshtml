@{
    Layout = "~/Views/Shared/_LayoutDocente.cshtml";
}

<div class="container mt-3">
    <h3 class="header-custom">Chatear con IA</h3>

    <div id="chatBox"
         style="border:1px solid #ccc;
            border-radius:6px;
            padding:10px;
            height:400px;
            overflow:auto;
            background:var(--bg-principal-light);">
        <!-- mensajes aparecerán aquí -->
    </div>

    <div class="input-group mt-2">
        <input id="promptInput" class="form-control" placeholder="Escribe tu mensaje..." />
        <button id="sendBtn" class="btn btn-primary">Enviar</button>
    </div>
</div>

@section Scripts{
    @Scripts.Render("~/bundles/iachat")
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script>window.appBase='@Url.Content("~")';</script>
}
