
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta name="viewport" content="width=device-width" charset="utf-8" />
    <title>403 - Acceso Denegado</title>

    <style>
        :root {
            --azul-500: #0D6EFD;
            --cyan-500: #1DB7F7;
            --gris-500: #D1D6DF;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: linear-gradient(135deg, var(--azul-500), var(--cyan-500));
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: white;
            padding: 60px 40px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            max-width: 480px;
            width: 90%;
        }

        .icon {
            font-size: 50px;
            margin-bottom: 10px;
        }

        .code {
            font-size: 70px;
            font-weight: 700;
            color: var(--azul-500);
            margin: 0;
        }

        h2 {
            margin-top: 10px;
            color: #333;
        }

        p {
            color: #666;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .btn-group {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: var(--azul-500);
            color: white;
        }

            .btn-primary:hover {
                background: var(--cyan-500);
                transform: translateY(-2px);
            }

        .btn-secondary {
            background: var(--gris-500);
            color: #333;
        }

            .btn-secondary:hover {
                background: #bfc5cf;
                transform: translateY(-2px);
            }

        @@media (max-width: 500px) {
            .card {
                padding: 40px 20px;
            }

            .code {
                font-size: 55px;
            }
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">🔒</div>
        <h1 class="code">403</h1>
        <h2>Acceso denegado</h2>
        <p>
            No tienes permisos para acceder a este recurso.
        </p>

        <div class="btn-group">
            <a href="/" class="btn btn-primary">Volver al inicio</a>
            <a href="javascript:history.back()" class="btn btn-secondary">Regresar</a>
        </div>
    </div>
</body>
</html>
