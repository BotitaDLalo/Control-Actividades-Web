@model List<ControlActividades.Models.DocentesValidacion>
@{
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}
<h1 class="title-custom">Ver docentes</h1>

<!-- Tabla de docentes -->
<div class="container-custom">
    <table id="tablaVerDocentes" class="table  table-striped table-hover">
        <thead class="table-header-custom">
            <tr>
                <th>Apellido Paterno</th>
                <th>Apellido Materno</th>
                <th>Nombres</th>
                <th>VER COMO</th>
            </tr>
        </thead>
        <tbody class="table-body-custom">
            @foreach (var docente in Model)
            {
                <tr data-status="active">
                    <td>@docente.ApellidoPaterno</td>
                    <td>@docente.ApellidoMaterno</td>
                    <td>@docente.Nombre</td>


                    <td>
                        @using (Html.BeginForm("IngresarComoDocente", "Administrador",
                                                FormMethod.Post
                                               ))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("userId", docente.UserId)

                            <button type="submit" class="btn-ver">
                                <img src="~/Content/Iconos/ojo-azul.svg" alt="Ingresar como docente" width="20">
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#tablaVerDocentes').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                searching: true,
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                }
            });
        });
    </script>
}