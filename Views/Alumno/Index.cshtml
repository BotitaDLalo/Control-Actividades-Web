@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAlumno.cshtml";

    int alumnoId = ViewBag.AlumnoId != null ? (int)ViewBag.AlumnoId : 0;
}

<div class="container my-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0">Tus clases</h1>
            <p class="text-muted small mb-0">Accede a tus grupos y materias desde aquí</p>
        </div>

        <div class="d-flex gap-2">
            <div class="input-group">
                <input id="buscarClasesInput" type="text" class="form-control" placeholder="Buscar clases..." />
                <button id="buscarBtn" class="btn btn-outline-secondary" type="button">Buscar</button>
            </div>
            <button id="btnAbrirUnirse" class="btn btn-primary">Entrar a una clase nueva</button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div id="contenedorClases" class="row g-3">
                <!-- Las tarjetas de clases se renderizan aqu� por JS -->
                <div id="estadoClases" class="col-12">
                    <div class="card border-0 shadow-sm p-4 text-center text-muted">
                        <p class="mb-0">Cargando tus clases...</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Mis materias</h5>
                    <p class="text-muted small">Listado de materias en las que est�s inscrito</p>
                    <div id="misMaterias" class="list-group">
                        <div class="list-group-item text-muted">Cargando materias...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal simple para ingresar código de acceso -->
    <div id="unirseModal" class="modal fade" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Entrar a una clase</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <label for="codigoAccesoInput" class="form-label">C�digo de acceso</label>
                    <input id="codigoAccesoInput" class="form-control" placeholder="Ingresa el c�digo" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button id="btnUnirseConfirm" type="button" class="btn btn-primary">Entrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <div id="alumno-datos" data-alumnoid="@alumnoId" style="display:none"></div>
    <script>
        // Exponer alumnoId a scripts cliente de forma segura mediante atributo data-
        (function(){
            var alumnoDiv = document.getElementById('alumno-datos');
            try {
                window.alumnoIdGlobal = (alumnoDiv && alumnoDiv.dataset && alumnoDiv.dataset.alumnoid) ? parseInt(alumnoDiv.dataset.alumnoid, 10) : null;
            } catch (e) { window.alumnoIdGlobal = null; }
        })();
    </script>
    <script src="~/Scripts/Alumno/Clases.js"></script>
    <script src="~/Scripts/Alumno/UnirseClase.js"></script>
    <script>
        // abrir modal cuando se presione el botón
        // Carga la lista "Mis materias" y calcula tareas pendientes por materia
        async function loadMisMaterias() {
            const container = document.getElementById('misMaterias');
            if (!container) return;
            container.innerHTML = '<div class="list-group-item text-muted">Cargando materias...</div>';

            try {
                const resp = await fetch(`/api/Materias/ObtenerMateriasAlumno?alumnoId=${alumnoIdGlobal}`);
                if (!resp.ok) throw new Error('No se pudieron obtener las materias');
                const materias = await resp.json();

                container.innerHTML = '';
                if (!Array.isArray(materias) || materias.length === 0) {
                    container.innerHTML = '<div class="list-group-item text-muted">No est�s inscrito en ninguna materia.</div>';
                    return;
                }

                for (const m of materias) {
                    const item = document.createElement('a');
                    item.href = `/Alumno/Clase?tipo=materia&id=${m.MateriaId}`;
                    item.className = 'list-group-item list-group-item-action d-flex flex-column align-items-start';

                    const title = document.createElement('div');
                    title.className = 'mb-1';
                    title.style.fontWeight = '600';
                    title.textContent = m.NombreMateria || m.NombreMateria || 'Materia';

                    const status = document.createElement('small');
                    status.className = 'materia-status text-muted';
                    status.textContent = 'Calculando tareas pendientes...';

                    item.appendChild(title);
                    item.appendChild(status);

                    container.appendChild(item);

                    // Obtener actividades visibles para el alumno (usa endpoint que filtra publicadas)
                    try {
                        const actResp = await fetch(`/Actividades/ObtenerActividadesPorMateria?materiaId=${m.MateriaId}`);
                        if (!actResp.ok) {
                            // No hay actividades visibles o error -> marcar sin pendientes
                            status.className = 'materia-status text-success';
                            status.textContent = 'Sin tareas pendientes';
                            continue;
                        }

                        const actividades = await actResp.json();
                        if (!Array.isArray(actividades) || actividades.length === 0) {
                            status.className = 'materia-status text-success';
                            status.textContent = 'Sin tareas pendientes';
                            continue;
                        }

                        // Para cada actividad consultar si el alumno ya entreg�
                        const checks = actividades.map(a =>
                            fetch(`/api/Alumnos/ObtenerEnviosActividadesAlumno?ActividadId=${a.ActividadId}&AlumnoId=${alumnoIdGlobal}`)
                                .then(r => ({ ok: r.ok, status: r.status }))
                                .catch(() => ({ ok: false }))
                        );

                        const results = await Promise.all(checks);

                        // Si r.ok == true => tiene entregas -> no pendiente
                        let pendientes = 0;
                        for (let i = 0; i < results.length; i++) {
                            const res = results[i];
                            if (!res.ok) pendientes++;
                        }

                        if (pendientes === 0) {
                            status.className = 'materia-status text-success';
                            status.textContent = 'Sin tareas pendientes';
                        } else {
                            status.className = 'materia-status text-danger';
                            status.textContent = pendientes + (pendientes === 1 ? ' tarea sin entregar' : ' tareas sin entregar');
                        }
                    } catch (err) {
                        status.className = 'materia-status text-muted';
                        status.textContent = 'No se pudo calcular estado';
                        console.warn('Error al calcular pendientes para materia', m.MateriaId, err);
                    }
                }
            } catch (e) {
                container.innerHTML = '<div class="list-group-item text-danger">Error cargando materias</div>';
                console.error(e);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Ejecutar carga de materias si estamos en la vista alumno y hay alumnoId
            try { if (typeof alumnoIdGlobal !== 'undefined' && alumnoIdGlobal) loadMisMaterias(); } catch (e) { }
        });
    </script>
    <script>
        // abrir modal cuando se presione el bot�n
        document.addEventListener('DOMContentLoaded', function () {
            var btn = document.getElementById('btnAbrirUnirse');
            var modalEl = document.getElementById('unirseModal');
            if (btn && modalEl) {
                btn.addEventListener('click', function () {
                    // usar bootstrap modal si est� disponible
                    try {
                        var modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    } catch (e) {
                        // fallback: mostrar clase show
                        modalEl.classList.add('show');
                    }
                });
            }

            var btnConfirm = document.getElementById('btnUnirseConfirm');
            if (btnConfirm) {
                btnConfirm.addEventListener('click', function () {
                    // llamar la funci�n definida en UnirseClase.js
                    if (typeof unirseAClase === 'function') {
                        unirseAClase();
                    } else {
                        alert('Funci�n de unirse no disponible');
                    }
                });
            }

            // Buscar local: filtra elementos en contenedorClases por nombre
            var buscarBtn = document.getElementById('buscarBtn');
            var buscarInput = document.getElementById('buscarClasesInput');
            buscarBtn && buscarBtn.addEventListener('click', function () {
                var q = buscarInput.value.trim().toLowerCase();
                var cards = document.querySelectorAll('#contenedorClases .class-card');
                if (!q) { cards.forEach(c => c.style.display = ''); return; }
                cards.forEach(function (c) {
                    var text = (c.innerText || '').toLowerCase();
                    c.style.display = text.indexOf(q) >= 0 ? '' : 'none';
                });
            });
        });
    </script>
}

