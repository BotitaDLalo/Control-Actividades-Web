@{
    Layout = "~/Views/Shared/_LayoutAlumno.cshtml";
    ViewBag.Title = "ActividadDetalle";
    int alumnoId = ViewBag.AlumnoId != null ? (int)ViewBag.AlumnoId :0;
    int actividadId = Request.QueryString["actividadId"] != null ? int.Parse(Request.QueryString["actividadId"]) :0;
}

<style>
    /* Simple improvements for ActividadDetalle */
    .actividad-card {
        background: #f8f9fb;
        border:1px solid #e3e7ea;
        padding:20px;
        border-radius:8px;
        box-shadow:02px6px rgba(0,0,0,0.03);
        margin-top:20px;
    }
    .actividad-header {
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:12px;
        margin-bottom:12px;
    }
    .fecha-limite-badge {
        background: linear-gradient(90deg,#f8d7da, #ffe8e8);
        color:#842029;
        padding:8px12px;
        border-radius:20px;
        font-weight:600;
        font-size:0.95rem;
    }
    #entregaForm .form-control { border-radius:6px; }
    #estadoEntrega pre { background:#fff; padding:8px; border-radius:6px; border:1px solid #e9ecef; }
</style>

<div class="container">
    <div class="actividad-card">
        <div class="actividad-header">
            <div>
                <h2 id="tituloActividad" style="margin:0;">Cargando...</h2>
                <p id="descripcionActividad" style="margin:6px000; color:#495057;"></p>
            </div>
            <div style="text-align:right;">
                <div class="fecha-limite-badge">Fecha límite: <span id="fechaLimite">—</span></div>
            </div>
        </div>

        <div id="estadoEntrega" style="margin-bottom:16px;"></div>

        <div id="entregaForm">
            <div class="mb-3">
                <label for="respuesta" class="form-label">Respuesta</label>
                <textarea id="respuesta" class="form-control" rows="6" placeholder="Escribe tu respuesta para el docente..."></textarea>
            </div>
            <div class="mb-3">
                <label for="respuestaLink" class="form-label">Enlace (opcional)</label>
                <input type="url" id="respuestaLink" class="form-control" placeholder="https://ejemplo.com/album" />
                <small class="text-muted">Puedes pegar un enlace a Google Photos, Drive, Imgur u otro servicio con tus fotos o archivos.</small>
            </div>
            <div class="mb-3">
                <label for="fileEntrega" class="form-label">Adjuntar archivo / foto (opcional)</label>
                <input type="file" id="fileEntrega" class="form-control" multiple />
            </div>
            <button class="btn btn-primary" id="btnEnviar">Enviar entrega</button>
        </div>

        <div id="calificacionAlumno" style="margin-top:20px;"></div>
    </div>
</div>

@section Scripts {
    <script>
        var alumnoIdGlobal = @alumnoId;
        var actividadIdGlobal = @actividadId;
    </script>
    <script src="~/Scripts/Alumno/actividadDetalle.js"></script>
}
