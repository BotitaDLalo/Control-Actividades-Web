@{
    ViewBag.Title = "Confirmar Email";
}


<!DOCTYPE html>
<html>
<head>
    <link rel="icon" href="~/Iconos/LOGO VERTICAL-26.svg" type="image/x-icon" />
    <title>Registrar</title>
</head>
<body>
    <div class="logo">
        <img src="@Url.Content("~/Content/Iconos/iconizer-LOGO HORIZONTAL-AzulF.svg")" alt="Logo" class="logo-image">
    </div>
    <div class="verify-box">
        <div class="login-header">
            <h2>Se ha enviado su solicitud para registrarse como docente</h2>
            <h3>Si es aprobado se le enviará un código de verificación a su correo electrónico</h3>
            <header>Ingresar código:</header>
        </div>
        @using (Html.BeginForm("ConfirmEmail", "Account", FormMethod.Post, new { @class = "form-signin" }))
        {
            @Html.AntiForgeryToken()
            <div class="verificarCodigo-form">
                <div class="input-box-code">
                    <label for="email"></label>
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*"
                           class="input-field code-input" id="Code1" name="Code1" required>

                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*"
                           class="input-field code-input" id="Code2" name="Code2" required>

                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*"
                           class="input-field code-input" id="Code3" name="Code3" required>

                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*"
                           class="input-field code-input" id="Code4" name="Code4" required>

                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*"
                           class="input-field code-input" id="Code5" name="Code5" required>

                </div>
                <div class="input-box">
                    <input type="submit" class="input-submit" value="Verificar">
                </div>
            </div>
        }
    </div>

    <script>
    const inputs = document.querySelectorAll(".code-input");

    inputs.forEach((input, index) => {

        // Solo permitir números
        input.addEventListener("input", function (e) {
            this.value = this.value.replace(/[^0-9]/g, '');

            if (this.value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
        });

        // Manejar Backspace
        input.addEventListener("keydown", function (e) {
            if (e.key === "Backspace" && this.value === '' && index > 0) {
                inputs[index - 1].focus();
            }
        });

    });
    </script>

</body>

</html>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

@section Styles{
    <link href="@Url.Content("~/Content/Login/Login.css")" rel="stylesheet" />
}