@{
    ViewBag.Title = "Confirmación de restablecimiento de contraseña";
}

<style>
    body {
        background-color: #d6dae2;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .reset-container {
        background: #ffffff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        text-align: center;
        max-width: 420px;
        width: 100%;
    }

    .reset-title {
        font-size: 26px;
        font-weight: 600;
        background: linear-gradient(90deg, #0d6efd, #1db7f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 20px;
    }

    .reset-message {
        font-size: 16px;
        color: #555;
        margin-bottom: 30px;
    }

    .btn-login {
        display: inline-block;
        padding: 12px 25px;
        font-size: 15px;
        font-weight: 500;
        color: #fff;
        background: linear-gradient(90deg, #0d6efd, #1db7f7);
        border: none;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(13, 110, 253, 0.3);
            opacity: 0.95;
        }
</style>

<main>
    <div class="reset-container">
        <h1 class="reset-title">@ViewBag.Title</h1>
        <p class="reset-message">
            Tu contraseña se restableció correctamente.
        </p>

        @Html.ActionLink(
            "Iniciar sesión",
            "Login",
            "Account",
            routeValues: null,
            htmlAttributes: new { @class = "btn-login", id = "loginLink" }
        )
    </div>
</main>