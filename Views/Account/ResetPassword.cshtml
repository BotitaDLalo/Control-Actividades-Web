@model ControlActividades.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Restablecer contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #0d6efd, #1db7f7);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .reset-container {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            width: 100%;
            max-width: 450px;
        }

        .reset-title {
            text-align: center;
            margin-bottom: 10px;
            font-weight: 600;
            color: #0d6efd;
        }

        .reset-subtitle {
            text-align: center;
            color: #6c757d;
            margin-bottom: 25px;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            font-weight: 500;
            margin-bottom: 5px;
            display: block;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #d6dae2;
            transition: all 0.3s ease;
            font-size: 14px;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
                outline: none;
            }

        .btn-primary-custom {
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(90deg, #0d6efd, #1db7f7);
            color: white;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s ease;
        }

            .btn-primary-custom:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(13, 110, 253, 0.3);
            }

        .text-danger {
            font-size: 13px;
            margin-bottom: 10px;
        }

        .readonly-input {
            background-color: #f5f7fa;
        }

        hr {
            border: none;
            height: 1px;
            background: #d6dae2;
            margin: 20px 0;
        }
    </style>
</head>
<body>

    <div class="reset-container">
        <h2 class="reset-title">@ViewBag.Title</h2>
        <p class="reset-subtitle">Ingrese su nueva contraseña</p>

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control readonly-input", @readonly = "readonly" })
            </div>

            @Html.HiddenFor(model => model.Email)
            @Html.HiddenFor(model => model.Code)

            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nueva contraseña" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirmar contraseña" })
            </div>

            <button type="submit" class="btn-primary-custom">
                Restablecer contraseña
            </button>
        }
    </div>

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }

</body>
</html>