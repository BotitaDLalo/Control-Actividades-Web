@{
    Layout = null;
    ViewBag.Title = "Registrarse";
}
@model ControlActividades.Models.RegisterViewModel
@using ControlActividades.Models

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="@Url.Content("~/Content/Iconos/logo2.svg")" type="image/x-icon" />

    <!-- Google Fonts -->
    @*<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&family=Roboto:wght@400;700&display=swap" rel="stylesheet">*@

    <!-- CSS personalizado -->
    @*<link href="~/css/InicioSesion/InicioSesion.css" rel="stylesheet" />*@
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link href="@Url.Content("~/Content/Login/Login.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Variables/colors.css")" rel="stylesheet" />

    <title>Registrar</title>
</head>
<body>


    <!--Contenedor de logo y form-->
    <div class="auth-container">
        <!--LEFT-->

        <div class="left-side">
            <img src="~/Content/Iconos/logo2.svg" alt="Logo" class="logo-img" />
            <h2 class="welcome-text">Bienvenido</h2>
        </div>

        <!--RIGHT-->

        <div class="right-side">
            <div class="form-wrapper">
                <div class="login-header">
                    <header>Registro</header>
                </div>

                @Html.ValidationSummary(true, "", new { @class = "error-message" })

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-signin" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="input-box">
                        @Html.TextBoxFor(m => m.ApellidoPaterno, new { @class = "input-field", autocomplete = "off" })
                        <label>Apellido Paterno</label>
                        @Html.ValidationMessageFor(m => m.ApellidoPaterno, "", new { @class = "error-message" })
                    </div>

                    <div class="input-box">
                        @Html.TextBoxFor(m => m.ApellidoMaterno, new { @class = "input-field", autocomplete = "off" })
                        <label>Apellido Materno</label>
                        @Html.ValidationMessageFor(m => m.ApellidoMaterno, "", new { @class = "error-message" })
                    </div>

                    <div class="input-box">
                        @Html.TextBoxFor(m => m.Nombres, new { @class = "input-field", autocomplete = "off" })
                        <label>Nombres</label>
                        @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "error-message" })
                    </div>

                    <div class="input-box">
                        @Html.PasswordFor(m => m.Password, new { @class = "input-field", autocomplete = "off" })
                        <label>Contraseña</label>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "error-message" })
                    </div>

                    <div class="mb-3">
                        @Html.DropDownListFor(m => m.Role,
                            new SelectList(
                                Enum.GetValues(typeof(Role))
                                    .Cast<Role>()
                                    .Where(r => r == Role.Docente || r == Role.Alumno)
                            ),
                            "Elige tu rol",
                            new { @class = "form-control form-control-lg" })
                        @Html.ValidationMessageFor(m => m.Role, "", new { @class = "error-message" })
                    </div>

                    <div class="input-box">
                        <input type="submit" class="input-submit" value="Registrarse" />
                    </div>
                }
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $.validator.setDefaults({
            onkeyup: false,
            onclick: false,
            onfocusout: false
        });
    </script>


    @if (TempData["Success"] != null)
    {
        <script>
        Swal.fire({
            icon: 'success',
            title: 'Éxito',
            text: '@TempData["Success"]',
            confirmButtonColor: '#3085d6'
        });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '@TempData["Error"]',
            confirmButtonColor: '#d33'
        });
        </script>
    }
</body>
</html>


    
