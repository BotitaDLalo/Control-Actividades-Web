@{
    ViewBag.Title = "Confirmación de contraseña olvidada";
}

<style>
    .banner {
        background-color: #3a7bd5;
        border-bottom-left-radius: 20%;
        border-bottom-right-radius: 20%
    }
    hgroup {
        color: white;
        text-align: center;
    }


    p {
        color: black;
        text-align: center;
    }
</style>

<body>
    <main aria-labelledby="title">
        <hgroup class="title banner">
            <h1 id="title">@ViewBag.Title.</h1>
        </hgroup>
        <div>
            <p>
                Revice su correo electrónico para restablecer la contraseña.
            </p>
            <a href="/">Volver al inicio</a>
        </div>
    </main>

</body>
