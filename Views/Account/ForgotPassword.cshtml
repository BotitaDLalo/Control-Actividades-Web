@model ControlActividades.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "¿Olvidó su contraseña?";
    Layout = null;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="@Url.Content("~/Content/Iconos/logo2.svg")" type="image/x-icon" />

    <!-- Load login stylesheet directly so centering works when rendered standalone -->
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link href="@Url.Content("~/Content/Login/Login.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Variables/colors.css")" rel="stylesheet" />
    <style>
        input[type="email"] {
            border: 1.5px solid #000;
        }

            input[type="email"]:focus {
                border-color: #000;
                box-shadow: 0 0 0 3px rgba(0,0,0,0.15);
                outline: none;
            }
    </style>
</head>

<body style="background-color:darkgray;">
    <main aria-labelledby="title">
        
        <div style="width:100vw; height: 100vh; display: flex;justify-content: center;align-items: center">
            
            <!--Contenedor de form-->
            <div style="background-color: white; padding:30px; border-radius:10px; min-width:300px; box-shadow:0 0 10px rgba(0,0,0,0.1); font-family: inter;">

                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
                {
                    <h2 id="title">@ViewBag.Title.</h2>
                    @Html.AntiForgeryToken()
                    <h4>Escriba su correo electrónico.</h4>

                    <hr />
                    @Html.ValidationSummary("", new { @class = "text-danger" })

                    <div style="margin-bottom:20px;">
                        @Html.LabelFor(m => m.Email, new { style = "display:block; font-weight:600; margin-bottom:6px;" })

                        @Html.TextBoxFor(m => m.Email, new
                        {
                        @class = "form-control",
                        type = "email",
                        placeholder = "correo@ejemplo.com",
                        style = "width:100%; padding:12px 14px; border-radius:8px; font-size:15px; transition: all 0.2s ease;"
                        })
                    </div>

                    <div>
                        <input type="submit" class="btn btn-outline-primary" value="Enviar enlace de recuperación" />
                    </div>
                }
            </div>

        </div>
        
        
    </main>

</body>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
